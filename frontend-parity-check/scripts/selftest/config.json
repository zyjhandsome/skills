{
  "$schema": "parity-config/v2",
  "name": "selftest",
  "outputDir": "./parity-run",
  "dataParity": "same-data",
  "styleIntent": "pixel-parity",
  "baseline": {
    "label": "old",
    "baseUrl": "http://127.0.0.1:9401",
    "auth": {
      "mode": "auto-interactive",
      "storageState": "./parity-run/auth-baseline.json",
      "interactive": { "profileDir": "./parity-run/auth-profile-baseline" }
    }
  },
  "candidate": {
    "label": "new",
    "baseUrl": "http://127.0.0.1:9402",
    "auth": { "mode": "auto-interactive", "storageState": "./parity-run/auth-candidate.json" },
    "pathOverrides": { "dashboard": "/shell-v2", "dashboard-notices": "/shell-v2" }
  },
  "context": {
    "viewports": [{ "name": "desktop", "width": 1280, "height": 800 }],
    "locale": "zh-CN",
    "timezoneId": "Asia/Shanghai",
    "freezeTime": "2026-01-01T09:00:00+08:00",
    "seedRandom": 42
  },
  "thresholds": { "pixelDiffRatio": 0.002, "settleMs": 200 },
  "routes": [
    {
      "id": "order-list",
      "path": "/",
      "waitFor": { "selector": ".el-table__row" },
      "states": [
        { "id": "default", "actions": [] },
        {
          "id": "search-filled",
          "actions": [
            { "type": "fill", "selector": "#kw", "value": "A001" },
            { "type": "click", "selector": ".el-button--primary" },
            { "type": "waitFor", "selector": ".el-table__row" }
          ]
        },
        {
          "id": "broken-state-action",
          "actions": [
            { "type": "click", "selector": ".definitely-missing", "timeout": 200 }
          ]
        }
      ]
    },
    {
      "id": "dashboard",
      "path": "/shell",
      "waitFor": { "selector": ".ann-item" }
    },
    {
      "id": "login-gate",
      "path": "/gate",
      "waitFor": { "selector": ".wrap" }
    },
    {
      "id": "bogus-anchor",
      "path": "/",
      "waitFor": { "selector": ".definitely-missing", "timeout": 2000 }
    },
    {
      "id": "server-error",
      "path": "/server-error"
    },
    {
      "id": "frame-report",
      "path": "/frame-shell",
      "compareSurface": {
        "id": "report-body",
        "frame": "iframe#report-frame",
        "root": "#report-main",
        "mainUrlPattern": "/frame-shell$",
        "frameUrlPattern": "/frame-report$",
        "readySelector": ".send"
      }
    }
  ],
  "journeys": [
    {
      "id": "search-open-detail",
      "startPath": "/",
      "waitFor": { "selector": ".el-table__row" },
      "steps": [
        { "type": "expectCount", "id": "rows-initial", "selector": ".el-table__row" },
        { "type": "fill", "selector": "#kw", "value": "A001" },
        { "type": "click", "selector": ".el-button--primary" },
        { "type": "expectCount", "id": "rows-after-search", "selector": ".el-table__row" },
        { "type": "capture", "id": "after-search" },
        { "type": "click", "selector": ".detail-link" },
        { "type": "waitFor", "selector": ".detail-panel h2", "timeout": 5000 },
        { "type": "expectText", "id": "detail-title", "selector": ".detail-panel h2" },
        { "type": "expectUrl", "id": "detail-url" }
      ]
    },
    {
      "id": "dashboard-notices",
      "startPath": "/shell",
      "waitFor": { "selector": ".ann-item" },
      "steps": [
        { "type": "expectCount", "id": "notices", "selector": ".ann-item" },
        { "type": "expectUrl", "id": "shell-url" },
        { "type": "capture", "id": "board" }
      ]
    },
    {
      "id": "frame-popup-report",
      "startPath": "/frame-shell",
      "compareSurface": {
        "frame": "iframe#report-frame",
        "root": "#report-main",
        "mainUrlPattern": "/frame-shell$",
        "frameUrlPattern": "/frame-report$",
        "readySelector": ".send"
      },
      "steps": [
        { "type": "expectVisible", "id": "send-visible", "selector": ".send" },
        { "type": "clickAndExpectPopup", "id": "open-preview", "popupId": "preview", "selector": ".send" },
        { "type": "waitFor", "id": "preview-ready", "scope": { "page": "preview" }, "selector": "h1" },
        { "type": "expectText", "id": "preview-title", "scope": { "page": "preview" }, "selector": "h1" }
      ]
    }
  ]
}
