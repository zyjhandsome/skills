{
  "$schema": "parity-config/v2",
  "name": "portal-dashboard-migration",
  "outputDir": "./parity-runs/portal-dashboard-migration",

  "browser": "chromium",
  "channel": "chrome",

  "dataParity": "different-data",
  "styleIntent": "pixel-parity",

  "defaultProbes": ["heading", "primary-button", "table-header-cell", "table-body-cell", "card"],

  "assertLanded": {
    "requireUrl": "(dashboard|project|portal)",
    "allowUrl": []
  },

  "compareSurface": {
    "id": "dashboard-business-body",
    "baseline": {
      "mainUrlPattern": "(dashboard|project|portal)",
      "root": ".portal-content"
    },
    "candidate": {
      "mainUrlPattern": "(dashboard|project|workspace)",
      "root": ".workspace-content"
    },
    "exclude": [".global-header", ".side-menu", ".aside-wrapper"]
  },

  "runtimePolicy": {
    "ignoreConsolePatterns": [],
    "ignoreRequestPatterns": [],
    "blockRequestPatterns": []
  },

  "dataSelectors": [".notice-list", ".ann-list", ".chart-data"],

  "urlNormalizeRules": [
    { "pattern": "\\.do(?=$|[?#])", "replace": "" },
    { "pattern": "([?&])(projectId|tenantId)=[^&#]*", "replace": "$1$2={id}" }
  ],

  "baseline": {
    "label": "旧门户 (AngularJS + JSP，顶栏在 iframe 里)",
    "baseUrl": "https://portal-old.example.com",
    "auth": {
      "mode": "auto-interactive",
      "storageState": "./auth/baseline.json",
      "interactive": { "timeoutMs": 600000, "probeTimeoutMs": 8000 }
    }
  },
  "candidate": {
    "label": "新宿主 (Vue3 原生托管)",
    "baseUrl": "https://portal-new.example.com",
    "auth": {
      "mode": "auto-interactive",
      "storageState": "./auth/candidate.json",
      "interactive": { "timeoutMs": 600000, "probeTimeoutMs": 8000 }
    },
    "pathOverrides": {
      "dashboard": "/workspace/project/dashboard",
      "notice-list": "/workspace/notice",
      "open-notice-detail": "/workspace/project/dashboard"
    }
  },

  "context": {
    "viewports": [{ "name": "desktop", "width": 1440, "height": 900 }],
    "deviceScaleFactor": 1,
    "locale": "zh-CN",
    "timezoneId": "Asia/Shanghai",
    "colorScheme": "light",
    "freezeTime": "2026-01-01T09:00:00+08:00",
    "seedRandom": 42,
    "timeoutMs": 20000,
    "navTimeoutMs": 60000
  },

  "masks": [
    ".chart-canvas",
    "canvas",
    ".refresh-time",
    ".kpi-trend-spark",
    "#nprogress"
  ],
  "maskTextPatterns": ["更新于\\s*\\S+", "\\b\\d+(\\.\\d+)?%"],

  "styleProbes": [
    { "id": "kpi-card", "baselineSelector": ".kpi-card", "candidateSelector": ".stat-card" },
    { "id": "kpi-value", "baselineSelector": ".kpi-card .value", "candidateSelector": ".stat-card .num" },
    { "id": "chart-wrap", "baselineSelector": ".chart-wrap", "candidateSelector": ".echarts-container" },
    { "id": "notice-item", "baselineSelector": ".notice-list li", "candidateSelector": ".ann-item" }
  ],

  "thresholds": {
    "pixelDiffRatio": 0.008,
    "pixelChannelTolerance": 32,
    "layoutTolerancePx": 3,
    "layoutToleranceRatio": 0.02,
    "settleMs": 800,
    "styleAggregateMinProbes": 3
  },

  "routes": [
    {
      "id": "dashboard",
      "path": "/hiapm/project/dashboard.do",
      "waitFor": { "baselineSelector": ".kpi-card", "candidateSelector": ".stat-card", "state": "visible" },
      "masks": [".kpi-trend-spark"],
      "states": [
        { "id": "default", "actions": [] },
        {
          "id": "quarter-filter",
          "actions": [
            { "type": "click", "selector": ".period-filter" },
            { "type": "click", "selector": "text=本季度" },
            { "type": "waitFor", "baselineSelector": ".kpi-card", "candidateSelector": ".stat-card" }
          ]
        }
      ]
    },
    {
      "id": "notice-list",
      "path": "/hiapm/notice.do",
      "waitFor": { "baselineSelector": ".notice-list li", "candidateSelector": ".ann-item" }
    }
  ],

  "journeys": [
    {
      "id": "open-notice-detail",
      "startPath": "/hiapm/project/dashboard.do",
      "waitFor": { "baselineSelector": ".kpi-card", "candidateSelector": ".stat-card" },
      "steps": [
        { "type": "expectCount", "id": "notices-visible", "baselineSelector": ".notice-list li", "candidateSelector": ".ann-item", "dataDependent": true },
        { "type": "expectText", "id": "first-notice", "baselineSelector": ".notice-list li", "candidateSelector": ".ann-item", "nth": 0, "dataDependent": true },
        { "type": "capture", "id": "board" },
        { "type": "click", "baselineSelector": ".notice-list li", "candidateSelector": ".ann-item", "nth": 0 },
        { "type": "waitFor", "selector": ".notice-detail, .el-dialog__body" },
        { "type": "expectText", "id": "detail-title", "selector": ".notice-detail h2, .el-dialog__title" },
        { "type": "expectUrl", "id": "detail-url", "ignorePath": true },
        { "type": "capture", "id": "notice-detail" }
      ]
    }
  ]
}
