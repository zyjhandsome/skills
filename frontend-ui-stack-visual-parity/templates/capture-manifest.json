{
  "schema": "visual-capture-manifest/v1",
  "producer": "frontend-ui-stack-visual-parity",
  "parity_topology": "same-repo",
  "baseline_root": "<optional-A-root-when-cross-repo>",
  "candidate_root": "<optional-B-root-when-cross-repo>",
  "source_snapshot": "<git-sha-or-content-snapshot>",
  "baseline_source": "<baseline-or-approved-substitute>",
  "capture_context": {
    "adapter_browser": "<adapter/browser>",
    "viewport_device_scale_factor": "<viewport/dsf>",
    "locale_timezone_theme": "<locale/timezone/theme>",
    "font_ready_condition": "<condition>",
    "animation_policy": "<policy>",
    "data_fixture_dynamic_masks": "<fixture/masks>"
  },
  "states": [
    {
      "id": "<state-id>",
      "route": "<route>",
      "state": "<state>",
      "baseline": "<path>",
      "current": "<path>",
      "diff": "<path-or-policy>",
      "result": "pending"
    }
  ]
}
